<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="16dp">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            android:tint="#F44336"
            android:layout_marginEnd="8dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Rechazar Solicitud de Crédito"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#212121" />

    </LinearLayout>

    <!-- Credit Request Info -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#FFEBEE"
        android:padding="12dp"
        android:layout_marginBottom="16dp">

        <TextView
            android:id="@+id/tv_request_info"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="CR-2024-001 - Juan Pérez García\nMonto solicitado: S/ 25,000"
            android:textSize="14sp"
            android:textColor="#D32F2F" />

    </LinearLayout>

    <!-- Rejection Reason -->
    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:hint="Motivo del rechazo">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/et_rejection_reason"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textMultiLine"
            android:lines="4"
            android:maxLines="6" />

    </com.google.android.material.textfield.TextInputLayout>

    <!-- Quick Rejection Reasons -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Motivos comunes:"
        android:textSize="14sp"
        android:textColor="#424242"
        android:layout_marginBottom="8dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginBottom="16dp">

        <Button
            android:id="@+id/btn_insufficient_income"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:text="Ingresos insuficientes"
            android:textSize="12sp"
            android:backgroundTint="#FF5722"
            android:gravity="start|center_vertical" />

        <Button
            android:id="@+id/btn_poor_credit_history"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:text="Historial crediticio deficiente"
            android:textSize="12sp"
            android:backgroundTint="#FF5722"
            android:gravity="start|center_vertical" />

        <Button
            android:id="@+id/btn_incomplete_documentation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:text="Documentación incompleta"
            android:textSize="12sp"
            android:backgroundTint="#FF5722"
            android:gravity="start|center_vertical" />

        <Button
            android:id="@+id/btn_excessive_debt_ratio"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Relación deuda-ingreso excesiva"
            android:textSize="12sp"
            android:backgroundTint="#FF5722"
            android:gravity="start|center_vertical" />

    </LinearLayout>

    <!-- Action Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btn_cancel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:text="Cancelar"
            android:backgroundTint="#757575" />

        <Button
            android:id="@+id/btn_reject"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="Rechazar"
            android:backgroundTint="#F44336" />

    </LinearLayout>

</LinearLayout>