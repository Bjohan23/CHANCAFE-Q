<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.products.ProductsActivity">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/red_primary"
            app:title="Productos"
            app:titleTextColor="@android:color/white"
            app:navigationIcon="@drawable/ic_home" />

        <!-- Barra de búsqueda -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="16dp"
            android:background="@color/red_primary">

            <EditText
                android:id="@+id/et_search"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="Buscar productos..."
                android:background="@drawable/bg_edittext"
                android:padding="12dp"
                android:drawableStart="@android:drawable/ic_menu_search"
                android:drawablePadding="8dp"
                android:textColor="@color/black"
                android:textColorHint="@color/gray_text"
                android:textSize="14sp" />

            <ImageView
                android:id="@+id/iv_filter"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginStart="8dp"
                android:src="@android:drawable/ic_menu_sort_by_size"
                android:background="@drawable/bg_button_secondary"
                android:padding="12dp"
                android:tint="@color/red_primary" />

        </LinearLayout>

    </com.google.android.material.appbar.AppBarLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <!-- Chips de filtros rápidos -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_all"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Todos"
                    android:layout_marginEnd="8dp"
                    android:checkable="true"
                    android:checked="true"
                    app:chipBackgroundColor="@color/red_primary"
                    app:chipStrokeColor="@color/red_primary"
                    android:textColor="@android:color/white" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_featured"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Destacados"
                    android:layout_marginEnd="8dp"
                    android:checkable="true"
                    app:chipBackgroundColor="@color/yellow_primary"
                    app:chipStrokeColor="@color/yellow_primary"
                    android:textColor="@color/black" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_low_stock"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Poco Stock"
                    android:layout_marginEnd="8dp"
                    android:checkable="true"
                    app:chipBackgroundColor="@android:color/holo_orange_light"
                    app:chipStrokeColor="@android:color/holo_orange_light"
                    android:textColor="@color/black" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_out_of_stock"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Sin Stock"
                    android:layout_marginEnd="8dp"
                    android:checkable="true"
                    app:chipBackgroundColor="@android:color/holo_red_light"
                    app:chipStrokeColor="@android:color/holo_red_light"
                    android:textColor="@android:color/white" />

            </LinearLayout>

        </HorizontalScrollView>

        <!-- Contenedor principal -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <!-- RecyclerView para productos -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_products"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="8dp"
                android:clipToPadding="false"
                tools:listitem="@layout/item_product" />

            <!-- Vista de carga -->
            <LinearLayout
                android:id="@+id/loading_layout"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center"
                android:visibility="gone">

                <ProgressBar
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:indeterminateTint="@color/red_primary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Cargando productos..."
                    android:textColor="@color/gray_text"
                    android:layout_marginTop="16dp" />

            </LinearLayout>

            <!-- Vista de error -->
            <LinearLayout
                android:id="@+id/error_layout"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center"
                android:visibility="gone"
                android:padding="32dp">

                <ImageView
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:src="@drawable/ic_products"
                    android:tint="@color/gray_text" />

                <TextView
                    android:id="@+id/tv_error_message"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Error al cargar productos"
                    android:textColor="@color/gray_text"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:layout_marginTop="16dp"
                    android:gravity="center" />

                <Button
                    android:id="@+id/btn_retry"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Reintentar"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/bg_button_primary"
                    android:textColor="@android:color/white"
                    android:paddingHorizontal="24dp" />

            </LinearLayout>

            <!-- Vista vacía -->
            <LinearLayout
                android:id="@+id/empty_layout"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center"
                android:visibility="gone"
                android:padding="32dp">

                <ImageView
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:src="@drawable/ic_products"
                    android:tint="@color/gray_text" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="No hay productos disponibles"
                    android:textColor="@color/gray_text"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:layout_marginTop="16dp"
                    android:gravity="center" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Agrega nuevos productos usando el botón +"
                    android:textColor="@color/gray_text"
                    android:textSize="14sp"
                    android:layout_marginTop="8dp"
                    android:gravity="center" />

            </LinearLayout>

        </FrameLayout>

    </LinearLayout>

    <!-- Botón flotante para agregar producto -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fab_add_product"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="16dp"
        android:src="@android:drawable/ic_menu_add"
        app:backgroundTint="@color/yellow_primary"
        app:tint="@color/black" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>